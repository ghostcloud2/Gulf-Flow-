# Set in Vercel Project Settings > Environment Variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: optional AI integration. Never use NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Explicitly allow outbound AI calls only after approval of privacy/data processing.
ENABLE_LIVE_AI=false
